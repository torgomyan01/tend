DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/tend_db"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_BOT_USERNAME="tend_am_bot"
NEXTAUTH_SECRET="GENERATE_A_LONG_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Production site URL (SEO, Telegram links, absolute URLs)
NEXT_PUBLIC_APP_URL="https://tend.am"

# Google OAuth (login + register). Create Web client in Google Cloud Console.
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://tend.am/api/auth/callback/google
# When unset, Google buttons are hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Analytics 4 (loaded only in production)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-MSS61328CW"

# Enables AI-generated tender title/description suggestions (DeepSeek).
# Key: https://platform.deepseek.com/api_keys
# Billing/top-up: https://platform.deepseek.com
# Recommended (cheapest): deepseek-flash. Stronger: deepseek-v4-pro.
# Optional base: DEEPSEEK_API_BASE.
# When DEEPSEEK_API_KEY is unset, AI buttons fail with AI_NOT_CONFIGURED.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"


# ITF VPOS (live). Escape $ in keys as \$ so Next.js does not expand them.
VPOS_PUBLIC_KEY=""
VPOS_PRIVATE_KEY=""
VPOS_BASE_URL="https://paymentsystem.itfllc.am/payments/live/"

# Protected deal (bank escrow). Fee is deducted from provider payout.
ESCROW_PLATFORM_FEE_PERCENT="1"
ESCROW_BANK_RECEIVER="Tend.am / TorgomyanStudio"
ESCROW_BANK_NAME="Հայաստանի բանկ"
ESCROW_BANK_ACCOUNT="0000000000000000"
ESCROW_BANK_HINT="Նշման դաշտում պարտադիր գրեք վճարման կոդը (TEND-ESC-...)"
